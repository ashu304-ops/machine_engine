// ── 1. HIGH-PERFORMANCE DATA MODELING & MEMORY ALIGNMENT ─────────────────────

enum class OrderSide : char { BUY = 'B', SELL = 'S' };
enum class OrderType : char { LIMIT = 'L', MARKET = 'M', IOC = 'I', FOK = 'F' };
enum class OrderStatus : char { OPEN = 'O', PARTIAL = 'P', FILLED = 'F', CANCELLED = 'C', REJECTED = 'R' };

// Aligned structure optimized for CPU cache lines
struct alignas(64) Order {
    int id;
    int price;
    int quantity;
    int initial_quantity;
    OrderSide side;
    OrderType type;
    OrderStatus status;
    uint64_t timestamp_ns;
};

// Trade execution report structure
struct TradeReport {
    int buy_id;
    int sell_id;
    int price;
    int quantity;
    uint64_t timestamp_ns;
};

// ── 2. PERSISTENCE LAYER: WRITE-AHEAD LOG (WAL) ──────────────────────────────

class WriteAheadLog {
private:
    ofstream log_file;
    mutex log_mtx;
public:
    explicit WriteAheadLog(const string& filename) {
        log_file.open(filename, ios::out | ios::binary | ios::app);
    }

    ~WriteAheadLog() {
        if (log_file.is_open()) log_file.close();
    }

    void append_order(const Order& order) {
        lock_guard<mutex> lk(log_mtx);
        if (!log_file.is_open()) return;
        // Binary serialization for speed
        log_file.write(reinterpret_cast<const char*>(&order), sizeof(Order));
        log_file.flush();
    }

    void append_cancel(int order_id, uint64_t ts) {
        lock_guard<mutex> lk(log_mtx);
        if (!log_file.is_open()) return;
        log_file.write(reinterpret_cast<const char*>(&order_id), sizeof(int));
        log_file.write(reinterpret_cast<const char*>(&ts), sizeof(uint64_t));
        log_file.flush();
    }
};

// ── 3. INTER-THREAD ASYNC RING BUFFER ENGINE ────────────────────────────────

enum class CommandType { ADD, CANCEL, MODIFY };

struct OrderCommand {
    CommandType cmd_type;
    Order order;
};

class OrderQueue {
private:
    queue<OrderCommand> q;
    mutex mtx;
    condition_variable cv;
    atomic<bool> done{false};
public:
    void push(const OrderCommand& cmd) {
        {
            lock_guard<mutex> lock(mtx);
            q.push(cmd);
        }
        cv.notify_one();
    }

    bool pop(OrderCommand& cmd) {
        unique_lock<mutex> lock(mtx);
        cv.wait(lock, [this]() { return !q.empty() || done; });
        if (q.empty() && done) return false;
        cmd = q.front();
        q.pop();
        return true;
    }

    void shutdown() {
        done = true;
        cv.notify_all();
    }
};

// ── 4. RING-BUFFER ASYNC LOCK-FREE LOGGER ────────────────────────────────────

class AsyncLogger {
private:
    queue<string> log_q;
    mutex mtx;
    condition_variable cv;
    thread worker;
    atomic<bool> running{true};

    void process_logs() {
        while (running || !log_q.empty()) {
            unique_lock<mutex> lock(mtx);
            cv.wait(lock, [this]() { return !log_q.empty() || !running; });
            while (!log_q.empty()) {
                cout << log_q.front();
                log_q.pop();
            }
        }
    }
public:
    AsyncLogger() { worker = thread(&AsyncLogger::process_logs, this); }
    ~AsyncLogger() {
        running = false;
        cv.notify_one();
        if (worker.joinable()) worker.join();
    }
    void log(const string& msg) {
        {
            lock_guard<mutex> lock(mtx);
            log_q.push(msg);
        }
        cv.notify_one();
    }
};

// Global services
static AsyncLogger g_logger;
static unique_ptr<WriteAheadLog> g_wal;

// ── 5. ULTRA-FAST O(1) MATCHING ENGINE (SINGLE-THREADED PATH) ─────────────────

class PriceLevel {
public:
    int price;
    int total_volume = 0;
    list<Order> orders_list; // Doubly linked list for O(1) removals
};

class OrderBookEngine {
private:
    // Sorted indices for retrieving best bid/ask prices quickly O(log M)
    map<int, PriceLevel, greater<int>> bids;
    map<int, PriceLevel> asks;

    // Fast lookups maps: Price -> PriceLevel Iterator
    unordered_map<int, map<int, PriceLevel, greater<int>>::iterator> bid_price_lookup;
    unordered_map<int, map<int, PriceLevel>::iterator> ask_price_lookup;

    // Fast O(1) Order tracking map: ID -> structural iterator
    struct BookPosition {
        bool is_buy;
        int price;
        list<Order>::iterator list_iter;
    };
    unordered_map<int, BookPosition> order_position_lookup;
    unordered_map<int, Order> historical_lookup; // Retains historical statuses

    uint64_t _get_timestamp_ns() {
        return chrono::duration_cast<chrono::nanoseconds>(
            chrono::high_resolution_clock::now().time_since_epoch()).count();
    }

    void _generate_trade_log(const TradeReport& tr) {
        stringstream ss;
        ss << "[TRADE] QTY=" << tr.quantity << " @ PRICE=" << tr.price
           << " | BUY_ID=" << tr.buy_id << " | SELL_ID=" << tr.sell_id
           << " | TS=" << tr.timestamp_ns << "ns\n";
        g_logger.log(ss.str());
    }

    bool _validate_fok(int price, int quantity, OrderSide side) {
        int available_qty = 0;
        if (side == OrderSide::BUY) {
            for (auto& [ask_price, level] : asks) {
                if (price < ask_price) break;
                available_qty += level.total_volume;
                if (available_qty >= quantity) return true;
            }
        } else {
            for (auto& [bid_price, level] : bids) {
                if (price > bid_price) break;
                available_qty += level.total_volume;
                if (available_qty >= quantity) return true;
            }
        }
        return false;
    }

public:
    void process_add(Order ord) {
        ord.timestamp_ns = _get_timestamp_ns();
        ord.status = OrderStatus::OPEN;
        ord.initial_quantity = ord.quantity;

        // FOK verification step
        if (ord.type == OrderType::FOK && !_validate_fok(ord.price, ord.quantity, ord.side)) {
            ord.status = OrderStatus::REJECTED;
            historical_lookup[ord.id] = ord;
            stringstream ss; ss << "[REJECTED] FOK Order ID=" << ord.id << " could not be filled entirely.\n";
            g_logger.log(ss.str());
            return;
        }

        g_wal->append_order(ord);

        if (ord.side == OrderSide::BUY) {
            // Match against Asks
            while (ord.quantity > 0 && !asks.empty()) {
                auto best_ask = asks.begin();
                if (ord.type != OrderType::MARKET && ord.price < best_ask->first) break;

                while (ord.quantity > 0 && !best_ask->second.orders_list.empty()) {
                    auto& match_ord = best_ask->second.orders_list.front();
                    int traded = min(ord.quantity, match_ord.quantity);

                    ord.quantity -= traded;
                    match_ord.quantity -= traded;
                    best_ask->second.total_volume -= traded;

                    _generate_trade_log({ord.id, match_ord.id, best_ask->first, traded, _get_timestamp_ns()});

                    if (match_ord.quantity == 0) {
                        match_ord.status = OrderStatus::FILLED;
                        historical_lookup[match_ord.id] = match_ord;
                        order_position_lookup.erase(match_ord.id);
                        best_ask->second.orders_list.pop_front();
                    } else {
                        match_ord.status = OrderStatus::PARTIAL;
                        historical_lookup[match_ord.id] = match_ord;
                    }
                }

                if (best_ask->second.orders_list.empty()) {
                    ask_price_lookup.erase(best_ask->first);
                    asks.erase(best_ask);
                }
            }

            // Book residual limits
            if (ord.quantity == 0) {
                ord.status = OrderStatus::FILLED;
                historical_lookup[ord.id] = ord;
            } else if (ord.type == OrderType::IOC || ord.type == OrderType::MARKET) {
                ord.status = (ord.quantity < ord.initial_quantity) ? OrderStatus::PARTIAL : OrderStatus::CANCELLED;
                historical_lookup[ord.id] = ord;
                stringstream ss; ss << "[EXPIRED] IOC/Market residual dropped for ID=" << ord.id << " QTY=" << ord.quantity << "\n";
                g_logger.log(ss.str());
            } else {
                ord.status = (ord.quantity < ord.initial_quantity) ? OrderStatus::PARTIAL : OrderStatus::OPEN;
                historical_lookup[ord.id] = ord;

                auto& level = bids[ord.price];
                level.price = ord.price;
                level.total_volume += ord.quantity;
                level.orders_list.push_back(ord);

                bid_price_lookup[ord.price] = bids.find(ord.price);
                order_position_lookup[ord.id] = {true, ord.price, prev(level.orders_list.end())};
            }

        } else { // SELL SIDE MATCHING
            while (ord.quantity > 0 && !bids.empty()) {
                auto best_bid = bids.begin();
                if (ord.type != OrderType::MARKET && ord.price > best_bid->first) break;

                while (ord.quantity > 0 && !best_bid->second.orders_list.empty()) {
                    auto& match_ord = best_bid->second.orders_list.front();
                    int traded = min(ord.quantity, match_ord.quantity);

                    ord.quantity -= traded;
                    match_ord.quantity -= traded;
                    best_bid->second.total_volume -= traded;

                    _generate_trade_log({match_ord.id, ord.id, best_bid->first, traded, _get_timestamp_ns()});

                    if (match_ord.quantity == 0) {
                        match_ord.status = OrderStatus::FILLED;
                        historical_lookup[match_ord.id] = match_ord;
                        order_position_lookup.erase(match_ord.id);
                        best_bid->second.orders_list.pop_front();
                    } else {
                        match_ord.status = OrderStatus::PARTIAL;
                        historical_lookup[match_ord.id] = match_ord;
                    }
                }

                if (best_bid->second.orders_list.empty()) {
                    bid_price_lookup.erase(best_bid->first);
                    bids.erase(best_bid);
                }
            }

            if (ord.quantity == 0) {
                ord.status = OrderStatus::FILLED;
                historical_lookup[ord.id] = ord;
            } else if (ord.type == OrderType::IOC || ord.type == OrderType::MARKET) {
                ord.status = (ord.quantity < ord.initial_quantity) ? OrderStatus::PARTIAL : OrderStatus::CANCELLED;
                historical_lookup[ord.id] = ord;
                stringstream ss; ss << "[EXPIRED] IOC/Market residual dropped for ID=" << ord.id << " QTY=" << ord.quantity << "\n";
                g_logger.log(ss.str());
            } else {
                ord.status = (ord.quantity < ord.initial_quantity) ? OrderStatus::PARTIAL : OrderStatus::OPEN;
                historical_lookup[ord.id] = ord;

                auto& level = asks[ord.price];
                level.price = ord.price;
                level.total_volume += ord.quantity;
                level.orders_list.push_back(ord);

                ask_price_lookup[ord.price] = asks.find(ord.price);
                order_position_lookup[ord.id] = {false, ord.price, prev(level.orders_list.end())};
            }
        }
    }

    // Direct O(1) Cancellation via captured List Node Iterator Map
    bool process_cancel(int id) {
        uint64_t ts = _get_timestamp_ns();
        auto it = order_position_lookup.find(id);
        if (it == order_position_lookup.end()) {
            stringstream ss; ss << "[CANCEL FAILED] ID=" << id << " not resting inside book.\n";
            g_logger.log(ss.str());
            return false;
        }

        g_wal->append_cancel(id, ts);
        BookPosition pos = it->second;

        if (pos.is_buy) {
            auto level_it = bid_price_lookup[pos.price];
            level_it->second.total_volume -= pos.list_iter->quantity;
            level_it->second.orders_list.erase(pos.list_iter);
            if (level_it->second.orders_list.empty()) {
                bid_price_lookup.erase(pos.price);
                bids.erase(level_it);
            }
        } else {
            auto level_it = ask_price_lookup[pos.price];
            level_it->second.total_volume -= pos.list_iter->quantity;
            level_it->second.orders_list.erase(pos.list_iter);
            if (level_it->second.orders_list.empty()) {
                ask_price_lookup.erase(pos.price);
                asks.erase(level_it);
            }
        }

        historical_lookup[id].status = OrderStatus::CANCELLED;
        historical_lookup[id].quantity = 0;
        order_position_lookup.erase(id);

        stringstream ss; ss << "[CANCELLED COMPLETE] ID=" << id << "\n";
        g_logger.log(ss.str());
        return true;
    }

    void process_modify(int id, int new_price, int new_qty) {
        auto it = historical_lookup.find(id);
        if (it == historical_lookup.end() || (it->second.status != OrderStatus::OPEN && it->second.status != OrderStatus::PARTIAL)) {
            stringstream ss; ss << "[MODIFY FAILED] ID=" << id << " cannot modify static states.\n";
            g_logger.log(ss.str());
            return;
        }

        OrderSide side = it->second.side;
        OrderType type = it->second.type;

        process_cancel(id);

        Order re_inject{id, new_price, new_qty, new_qty, side, type, OrderStatus::OPEN, 0};
        process_add(re_inject);
    }

    void debug_dump() {
        stringstream ss;
        ss << "\n--- CURRENT SNAPSHOT BASE ASKS ---\n";
        for (auto& [p, lvl] : asks) ss << "  Price: " << p << " | Agg Vol: " << lvl.total_volume << "\n";
        ss << "--- CURRENT SNAPSHOT BASE BIDS ---\n";
        for (auto& [p, lvl] : bids) ss << "  Price: " << p << " | Agg Vol: " << lvl.total_volume << "\n";
        g_logger.log(ss.str());
    }
};

// ── 6. ACTOR RUNTIME IMPLEMENTATION ──────────────────────────────────────────

class EngineActor {
private:
    OrderQueue cmd_queue;
    OrderBookEngine book;
    thread engine_thread;

    void run() {
        OrderCommand cmd;
        while (cmd_queue.pop(cmd)) {
            switch (cmd.cmd_type) {
                case CommandType::ADD:    book.process_add(cmd.order); break;
                case CommandType::CANCEL: book.process_cancel(cmd.order.id); break;
                case CommandType::MODIFY: book.process_modify(cmd.order.id, cmd.order.price, cmd.order.quantity); break;
            }
        }
    }
public:
    EngineActor() { engine_thread = thread(&EngineActor::run, this); }

    ~EngineActor() {
        cmd_queue.shutdown();
        if (engine_thread.joinable()) engine_thread.join();
    }

    void submit_add(int id, int price, int qty, OrderSide side, OrderType type) {
        cmd_queue.push({CommandType::ADD, Order{id, price, qty, qty, side, type, OrderStatus::OPEN, 0}});
    }

    void submit_cancel(int id) {
        Order dummy; dummy.id = id;
        cmd_queue.push({CommandType::CANCEL, dummy});
    }

    void submit_modify(int id, int new_price, int new_qty) {
        Order dummy; dummy.id = id; dummy.price = new_price; dummy.quantity = new_qty;
        cmd_queue.push({CommandType::MODIFY, dummy});
    }

    void request_dump() {
        // Run safely by scheduling context onto execution thread block safely
        // For simplicity in testing execution path, invoke directly when concurrent ingestion sleeps.
        book.debug_dump();
    }
};

// ── 7. MULTITHREADED CONCURRENT RUNTIME DEMO ────────────────────────────────

static atomic<int> global_id_gen{1};

int main() {
    g_wal = make_unique<WriteAheadLog>("engine_wal.dat");
    EngineActor exchange;

    auto user_producer = [&](int thread_id, int batch_size) {
        for (int i = 0; i < batch_size; ++i) {
            int id = global_id_gen.fetch_add(1, memory_order_relaxed);
            OrderSide side = (id % 2 == 0) ? OrderSide::BUY : OrderSide::SELL;
            // Generate crossable orders to exercise the matching system
            int price = (side == OrderSide::BUY) ? 100 + (id % 5) : 98 + (id % 5);
            int qty = 10 + (id % 10);

            exchange.submit_add(id, price, qty, side, OrderType::LIMIT);
            this_thread::sleep_for(chrono::microseconds(10));
        }
    };

    const int WORKERS = 4;
    const int CARRIED_LOAD = 15;
    vector<thread> pool;

    stringstream ss; ss << "Launching " << WORKERS << " concurrent active order producers...\n";
    g_logger.log(ss.str());

    for (int i = 0; i < WORKERS; ++i) {
        pool.emplace_back(user_producer, i, CARRIED_LOAD);
    }

    for (auto& t : pool) t.join();

    // Sleep briefly to ensure the matching engine thread finishes processing the backlogged queue
    this_thread::sleep_for(chrono::milliseconds(200));

    // Demonstrate complex execution behaviors (IOC, FOK, Cancellation)
    int test_id_1 = global_id_gen.fetch_add(1);
    int test_id_2 = global_id_gen.fetch_add(1);

    g_logger.log("\n--- Executing Specialized Routing Rules ---\n");
    exchange.submit_add(test_id_1, 105, 50, OrderSide::BUY, OrderType::LIMIT); // Resting
    exchange.submit_add(test_id_2, 105, 100, OrderSide::SELL, OrderType::FOK); // FOK execution (Should reject if total size fails)

    this_thread::sleep_for(chrono::milliseconds(50));
    exchange.submit_cancel(test_id_1);

    this_thread::sleep_for(chrono::milliseconds(100));
    exchange.request_dump();

    g_logger.log("\nShutting down engine structures smoothly.\n");
    return 0;
}
